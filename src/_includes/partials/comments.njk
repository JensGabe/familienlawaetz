{%- set itemComments = wp.comments | commentsFor(wpId) -%}
<section class="comments" id="kommentarer" aria-label="Kommentarer">
{%- if itemComments.length %}
  <h2 class="comments-title">{{ itemComments.length }} svar til <em>{{ title }}</em></h2>
  <ol class="comment-list">
  {%- for c in itemComments %}
    <li class="comment" id="comment-{{ c.id }}">
      <p class="comment-header"><cite class="comment-author">{{ c.author }}</cite><span class="sep"> · </span><a href="#comment-{{ c.id }}"><time datetime="{{ c.date | sitemapDate }}">{{ c.date | daDate }} kl. {{ c.date | wpTime }}</time></a></p>
      <div class="comment-body">{{ c.content | safe }}</div>
    </li>
  {%- endfor %}
  </ol>
{%- endif %}
  <p class="comments-closed">Kommentarer er lukket.</p>
</section>
