---
layout: layouts/base.njk
---
{%- set crumbs = collections.pages | navTree | ancestorsOf(page.url) %}
<article class="entry"{% if not hide or showHidden %} data-pagefind-body{% endif %}>
  <header class="entry-header">
    {%- if crumbs.length %}
    <nav class="crumbs" aria-label="Du er her" data-pagefind-ignore>
      <ol>{% for c in crumbs %}<li><a href="{{ c.url }}">{{ c.navTitle }}</a></li>{% endfor %}</ol>
    </nav>
    {%- endif %}
    <h1 class="entry-title">{{ title }}</h1>
  </header>
  <div class="prose">
{{ content | safe }}
  </div>
</article>
