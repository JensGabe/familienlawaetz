---
layout: layouts/base.njk
isHome: true
pagination:
  data: collections.posts
  size: 10
  alias: pagePosts
permalink: "{% if pagination.pageNumber > 0 %}/page/{{ pagination.pageNumber + 1 }}/{% else %}/{% endif %}"
---
<h1 class="label">Nyt fra familien</h1>
<div class="post-list">
{%- for p in pagePosts %}
{% include "partials/entry.njk" %}
{%- endfor %}
</div>
{%- if pagination.pages.length > 1 %}
<nav class="post-nav" aria-label="Flere indlæg">
  <div>{% if pagination.href.next %}<a class="prev" href="{{ pagination.href.next }}"><span>← Ældre indlæg</span></a>{% endif %}</div>
  <div>{% if pagination.href.previous %}<a class="next" href="{{ pagination.href.previous }}"><span>Nyere indlæg →</span></a>{% endif %}</div>
</nav>
{%- endif %}
