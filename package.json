{
  "name": "familien-lawaetz",
  "version": "1.0.0",
  "private": true,
  "description": "Familien Lawaetz – static 11ty site migrated from WordPress",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve",
    "serve": "npm run build && npx @11ty/eleventy-dev-server --dir=_site",
    "build:eleventy:github-pages": "cross-env ELEVENTY_ENV=test eleventy --pathprefix=/familienlawaetz/",
    "build:eleventy:prod": "cross-env ELEVENTY_ENV=production eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "cross-env": "^10.1.0",
    "markdown-it-attrs": "^4.5.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-image-figures": "^2.1.1",
    "pagefind": "^1.6.0"
  }
}
