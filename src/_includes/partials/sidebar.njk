<div id="primary" class="widget-area" role="complementary">
	<ul>
		<li class="widget-container widget_facebook">
			<h3 class="widget-title"><a href="{{ site.facebookGroup }}">Familien-Lawaetz</a></h3>
			<p>Følg familien i <a href="{{ site.facebookGroup }}">Facebook-gruppen Familien-Lawaetz</a>.</p>
		</li>
		<li class="widget-container">
			<h3 class="widget-title">Nyt fra Familien Lawaetz</h3>
			<ul>
			{%- for p in collections.posts | head(5) %}
				<li><a href="{{ p.url }}">{{ p.data.title }}</a> {{ p.date | wpDate }}</li>
			{%- endfor %}
			</ul>
		</li>
		<li class="widget-container widget_search">
			<form role="search" method="get" id="searchform" action="/soeg/">
				<div>
					<label class="screen-reader-text" for="s">Søg efter:</label>
					<input type="text" value="" name="q" id="s">
					<input type="submit" id="searchsubmit" value="Søg">
				</div>
			</form>
		</li>
	</ul>
</div>
