{%- macro menu(items, pageUrl) -%}
{%- for item in items %}
<li class="page_item{% if item.children.length %} page_item_has_children{% endif %}{% if item.url == pageUrl %} current_page_item{% elif item.url | isAncestorUrl(pageUrl) %} current_page_ancestor{% endif %}"><a href="{{ item.url | url }}">{{ item.title }}</a>
{%- if item.children.length %}
<ul class="children">{{ menu(item.children, pageUrl) }}</ul>
{%- endif %}</li>
{%- endfor %}
{%- endmacro -%}
