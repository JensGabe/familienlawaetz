---
layout: layouts/base.njk
isHome: true
pagination:
  data: collections.posts
  size: 10
  alias: pagePosts
permalink: "{% if pagination.pageNumber > 0 %}/page/{{ pagination.pageNumber + 1 }}/{% else %}/{% endif %}"
---
{%- for p in pagePosts %}
{% include "partials/entry.njk" %}
{%- endfor %}
{%- if pagination.pages.length > 1 %}
<div id="nav-below" class="navigation">
	<div class="nav-previous">{% if pagination.href.next %}<a href="{{ pagination.href.next }}">&larr; Ældre indlæg</a>{% endif %}</div>
	<div class="nav-next">{% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">Nyere indlæg &rarr;</a>{% endif %}</div>
</div>
{%- endif %}
