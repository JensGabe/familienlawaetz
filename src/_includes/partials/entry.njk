{#- One post as it appears in a listing (front page, category archive). Expects `p`. -#}
{%- set cats = wp.categories | categoriesFor(p.data.categories) %}
{%- set n = (wp.comments | commentsFor(p.data.wpId)).length %}
<article class="entry">
  <h2 class="entry-title"><a href="{{ p.url }}" rel="bookmark">{{ p.data.title }}</a></h2>
  <p class="meta"><time datetime="{{ p.date | sitemapDate }}">{{ p.date | daDate }}</time>{% if p.data.author %}<span class="sep">·</span>{{ p.data.author }}{% endif %}</p>
  <div class="prose">
{{ p.content | safe }}
  </div>
  {%- if cats.length or n %}
  <p class="entry-footer">
    {%- if cats.length %}Kategori: {% for c in cats %}<a href="/category/{{ c.slug }}/" rel="category tag">{{ c.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
    {%- if cats.length and n %}<span class="sep"> · </span>{% endif %}
    {%- if n %}<a href="{{ p.url }}#kommentarer">{{ n }} kommentar{% if n > 1 %}er{% endif %}</a>{% endif %}
  </p>
  {%- endif %}
</article>
